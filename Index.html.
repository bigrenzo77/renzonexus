<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#080c18">

  <title>RenzoNexus — One World. Endless Possibilities.</title>

  <meta name="description"
        content="Discover products, explore events, and find your next favourite thing with RenzoNexus. One World. Endless Possibilities.">

  <style>
    :root {
      --bg: #080c18;
      --panel: #10182a;
      --panel-light: #151f35;
      --blue: #4e8cff;
      --purple: #9c6cff;
      --silver: #e8edf8;
      --muted: #a5b0c7;
      --border: rgba(255,255,255,.10);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background: var(--bg);
      color: var(--silver);
      font-family: Arial, Helvetica, sans-serif;
      line-height: 1.6;
      overflow-x: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button, input {
      font: inherit;
    }

    button, a {
      -webkit-tap-highlight-color: transparent;
    }

    .container {
      width: min(1180px, 92%);
      margin: auto;
    }

    .announcement {
      text-align: center;
      padding: 9px 12px;
      background: linear-gradient(90deg, #173b83, #45217a);
      font-size: 12px;
      letter-spacing: .5px;
    }

    header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(8,12,24,.93);
      backdrop-filter: blur(18px);
      border-bottom: 1px solid var(--border);
    }

    .navbar {
      min-height: 76px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .logo {
      font-size: 24px;
      font-weight: 900;
      letter-spacing: -1px;
      white-space: nowrap;
    }

    .logo span {
      color: var(--blue);
    }

    nav {
      display: flex;
      align-items: center;
      gap: 22px;
      font-size: 13px;
      color: var(--muted);
    }

    nav a:hover {
      color: white;
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 11px 17px;
      color: white;
      font-weight: 700;
      font-size: 13px;
      cursor: pointer;
      transition: .2s;
    }

    .btn:hover {
      transform: translateY(-2px);
    }

    .btn-primary {
      border: none;
      background: linear-gradient(110deg, #367dff, #8154f7);
      box-shadow: 0 8px 28px rgba(69,113,255,.22);
    }

    .btn-outline {
      background: rgba(255,255,255,.03);
    }

    .hero {
      position: relative;
      min-height: 570px;
      display: flex;
      align-items: center;
      overflow: hidden;
      background:
        linear-gradient(90deg, #080c18 3%, rgba(8,12,24,.92) 34%,
        rgba(8,12,24,.30) 100%),
        url("https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&fit=crop&w=1800&q=85")
        center/cover;
    }

    .hero::after {
      content: "";
      position: absolute;
      width: 420px;
      height: 420px;
      border-radius: 50%;
      background: rgba(67,103,255,.15);
      filter: blur(100px);
      right: -100px;
      bottom: -150px;
      pointer-events: none;
    }

    .hero-content {
      position: relative;
      z-index: 2;
      max-width: 680px;
      padding: 85px 0;
    }

    .eyebrow {
      display: inline-block;
      color: #a9c7ff;
      border: 1px solid rgba(100,150,255,.32);
      background: rgba(48,94,190,.13);
      padding: 7px 12px;
      border-radius: 30px;
      font-size: 11px;
      font-weight: bold;
      letter-spacing: 1.3px;
      margin-bottom: 22px;
    }

    h1 {
      font-size: clamp(42px, 7vw, 76px);
      line-height: 1.06;
      letter-spacing: -3px;
      margin-bottom: 24px;
    }

    h1 span {
      background: linear-gradient(100deg, #a7caff, #8b83ff, #d7b5ff);
      color: transparent;
      background-clip: text;
      -webkit-background-clip: text;
    }

    .hero p {
      max-width: 540px;
      color: #c0c9db;
      font-size: 16px;
      margin-bottom: 30px;
    }

    .hero-buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }

    .hero-note {
      font-size: 12px;
      color: var(--muted);
      margin-top: 25px;
    }

    .section {
      padding: 78px 0;
    }

    .section-header {
      display: flex;
      justify-content: space-between;
      align-items: end;
      gap: 20px;
      margin-bottom: 30px;
    }

    .section-header h2 {
      font-size: clamp(25px, 4vw, 37px);
      letter-spacing: -1px;
    }

    .section-header p {
      color: var(--muted);
      font-size: 14px;
      margin-top: 5px;
    }

    .text-link {
      color: #a9c7ff;
      font-size: 13px;
      white-space: nowrap;
    }

    .search-box {
      display: flex;
      gap: 10px;
      margin: 30px 0 20px;
    }

    .search-box input {
      min-width: 0;
      flex: 1;
      background: var(--panel);
      border: 1px solid var(--border);
      color: white;
      padding: 15px 17px;
      border-radius: 11px;
      outline: none;
    }

    .search-box input:focus {
      border-color: var(--blue);
    }

    .categories {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .category {
      border: 1px solid var(--border);
      color: #c4cee1;
      padding: 9px 15px;
      border-radius: 30px;
      background: var(--panel);
      cursor: pointer;
      font-size: 12px;
    }

    .category.active,
    .category:hover {
      border-color: var(--blue);
      background: rgba(78,140,255,.14);
      color: white;
    }

    .path-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 15px;
    }

    .path-card {
      background: linear-gradient(145deg, #141e34, #0e1423);
      border: 1px solid var(--border);
      border-radius: 17px;
      padding: 25px 20px;
      transition: .25s;
    }

    .path-card:hover {
      transform: translateY(-5px);
      border-color: rgba(100,150,255,.6);
    }

    .path-icon {
      font-size: 28px;
      margin-bottom: 17px;
    }

    .path-card h3 {
      font-size: 17px;
      margin-bottom: 7px;
    }

    .path-card p {
      color: var(--muted);
      font-size: 12px;
      margin-bottom: 17px;
    }

    .path-card a {
      color: #a9c7ff;
      font-size: 12px;
      font-weight: bold;
    }

    .market-section {
      background: linear-gradient(180deg, #0b1020, #0d1322);
      border-top: 1px solid rgba(255,255,255,.03);
      border-bottom: 1px solid rgba(255,255,255,.03);
    }

    .product-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
    }

    .product-card {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 16px;
      overflow: hidden;
      transition: .25s;
    }

    .product-card:hover {
      transform: translateY(-5px);
      border-color: rgba(78,140,255,.5);
    }

    .product-image {
      height: 210px;
      position: relative;
      overflow: hidden;
      background: #182139;
    }

    .product-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform .4s;
    }

    .product-card:hover img {
      transform: scale(1.05);
    }

    .badge {
      position: absolute;
      left: 12px;
      top: 12px;
      background: rgba(8,12,24,.88);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 5px 9px;
      font-size: 10px;
    }

    .product-info {
      padding: 16px;
    }

    .product-info h3 {
      font-size: 14px;
      margin-bottom: 5px;
    }

    .product-info p {
      color: var(--muted);
      font-size: 11px;
      margin-bottom: 12px;
    }

    .product-bottom {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }

    .price {
      font-weight: bold;
      font-size: 13px;
    }

    .sample-label {
      display: inline-block;
      margin-top: 12px;
      font-size: 10px;
      color: #f2cf8c;
    }

    .feature-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 22px;
    }

    .feature-card {
      min-height: 370px;
      display: flex;
      align-items: end;
      position: relative;
      overflow: hidden;
      border: 1px solid var(--border);
      border-radius: 20px;
      background-position: center;
      background-size: cover;
    }

    .feature-card::before {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(0deg, rgba(5,8,17,.98), rgba(5,8,17,.05) 100%);
    }

    .feature-content {
      position: relative;
      padding: 28px;
      z-index: 1;
    }

    .feature-content .mini-label {
      color: #b9caff;
      font-size: 11px;
      font-weight: bold;
      letter-spacing: 1.4px;
    }

    .feature-content h3 {
      font-size: 29px;
      margin: 7px 0;
    }

    .feature-content p {
      color: #d0d7e7;
      font-size: 13px;
      max-width: 400px;
      margin-bottom: 18px;
    }

    .live-card {
      background-image: url("https://images.unsplash.com/photo-1459749411175-04bf5292ceea?auto=format&fit=crop&w=1100&q=85");
    }

    .merch-card {
      background-image: url("https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?auto=format&fit=crop&w=1100&q=85");
    }

    .trust-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .trust-card {
      border: 1px solid var(--border);
      border-radius: 15px;
      padding: 24px;
      background: rgba(255,255,255,.02);
    }

    .trust-card h3 {
      margin: 12px 0 7px;
      font-size: 16px;
    }

    .trust-card p {
      color: var(--muted);
      font-size: 13px;
    }

    .join-banner {
      padding: 42px;
      border-radius: 22px;
      background:
        radial-gradient(circle at 100% 0%, rgba(132,83,255,.3), transparent 40%),
        linear-gradient(120deg, #14284d, #11172c);
      border: 1px solid rgba(120,150,255,.2);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 25px;
    }

    .join-banner h2 {
      font-size: clamp(24px, 4vw, 36px);
      line-height: 1.2;
      margin-bottom: 10px;
    }

    .join-banner p {
      color: #c2cce0;
      font-size: 13px;
      max-width: 550px;
    }

    footer {
      border-top: 1px solid var(--border);
      padding: 50px 0 25px;
      background: #070a13;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: 30px;
      margin-bottom: 40px;
    }

    .footer-about p {
      max-width: 340px;
      color: var(--muted);
      font-size: 13px;
      margin-top: 15px;
    }

    .footer-column h4 {
      font-size: 13px;
      margin-bottom: 14px;
    }

    .footer-column a {
      display: block;
      color: var(--muted);
      font-size: 12px;
      margin: 9px 0;
    }

    .footer-column a:hover {
      color: white;
    }

    .footer-bottom {
      padding-top: 20px;
      border-top: 1px solid var(--border);
      color: #8591a8;
      font-size: 11px;
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
    }

    .notice {
      color: #b6c2d8;
      background: rgba(255,255,255,.035);
      border: 1px solid var(--border);
      padding: 14px;
      border-radius: 10px;
      font-size: 11px;
      margin-top: 25px;
    }

    @media (max-width: 900px) {
      nav {
        gap: 12px;
        font-size: 11px;
      }

      .path-grid,
      .product-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .product-image {
        height: 190px;
      }

      .footer-grid {
        grid-template-columns: 1fr 1fr;
      }
    }

    @media (max-width: 600px) {
      .announcement {
        font-size: 10px;
      }

      .navbar {
        min-height: 65px;
        flex-wrap: wrap;
        padding: 12px 0;
      }

      .logo {
        font-size: 21px;
      }

      nav {
        order: 3;
        width: 100%;
        overflow-x: auto;
        padding: 5px 0 8px;
        gap: 20px;
      }

      nav a {
        white-space: nowrap;
      }

      .nav-actions .btn {
        padding: 9px 10px;
        font-size: 11px;
      }

      .hero {
        min-height: 520px;
        background-position: 58% center;
      }

      .hero-content {
        padding: 65px 0;
      }

      h1 {
        letter-spacing: -1.5px;
      }

      .hero p {
        font-size: 14px;
      }

      .section {
        padding: 55px 0;
      }

      .section-header {
        align-items: start;
      }

      .section-header .text-link {
        margin-top: 8px;
      }

      .path-grid {
        grid-template-columns: 1fr 1fr;
        gap: 10px;
      }

      .path-card {
        padding: 18px 14px;
      }

      .product-grid {
        gap: 11px;
      }

      .product-image {
        height: 145px;
      }

      .product-info {
        padding: 12px;
      }

      .product-info h3 {
        font-size: 12px;
      }

      .product-info p {
        font-size: 10px;
      }

      .product-bottom {
        align-items: start;
        flex-direction: column;
      }

      .product-bottom .btn {
        width: 100%;
      }

      .feature-grid,
      .trust-grid {
        grid-template-columns: 1fr;
      }

      .feature-card {
        min-height: 320px;
      }

      .feature-content {
        padding: 22px;
      }

      .feature-content h3 {
        font-size: 25px;
      }

      .join-banner {
        padding: 27px 22px;
        align-items: start;
        flex-direction: column;
      }

      .footer-grid {
        grid-template-columns: 1fr 1fr;
        gap: 25px 15px;
      }

      .footer-about {
        grid-column: 1 / -1;
      }
    }
  </style>
</head>

<body>

  <div class="announcement">
    A new world of shopping, events and discovery. Welcome to RenzoNexus.
  </div>

  <header>
    <div class="container navbar">

      <a href="#home" class="logo">Renzo<span>Nexus</span></a>

      <nav aria-label="Main navigation">
        <a href="#shop">Shop</a>
        <a href="#live">Live & Tickets</a>
        <a href="#merch">Merchandise</a>
        <a href="#trust">Why RenzoNexus</a>
        <a href="#sell">Sell with us</a>
      </nav>

      <div class="nav-actions">
        <a href="#join" class="btn btn-outline">Sign in</a>
        <a href="#join" class="btn btn-primary">Get started</a>
      </div>

    </div>
  </header>

  <main>

    <section class="hero" id="home">
      <div class="container">
        <div class="hero-content">

          <span class="eyebrow">ONE PLATFORM. ENDLESS POSSIBILITIES.</span>

          <h1>
            Discover more.<br>
            <span>Connect to everything.</span>
          </h1>

          <p>
            Explore products, discover live experiences and find unique
            merchandise. Your next great discovery starts here.
          </p>

          <div class="hero-buttons">
            <a href="#shop" class="btn btn-primary">
              Explore marketplace →
            </a>

            <a href="#live" class="btn btn-outline">
              Discover events
            </a>
          </div>

          <div class="hero-note">
            Shop independently. Discover globally. Be part of something bigger.
          </div>

        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">

        <div class="section-header">
          <div>
            <h2>What brings you here?</h2>
            <p>Choose your path. Discover what RenzoNexus has to offer.</p>
          </div>
        </div>

        <div class="path-grid">

          <div class="path-card">
            <div class="path-icon">🛍️</div>
            <h3>I'm here to buy</h3>
            <p>Explore products and discover independent brands.</p>
            <a href="#shop">Explore shopping →</a>
          </div>

          <div class="path-card">
            <div class="path-icon">🏪</div>
            <h3>I want to sell</h3>
            <p>Apply to showcase your products to new customers.</p>
            <a href="#sell">Become a seller →</a>
          </div>

          <div class="path-card">
            <div class="path-icon">🎟️</div>
            <h3>I organise events</h3>
            <p>Apply to list eligible events and reach more fans.</p>
            <a href="#sell">Explore organising →</a>
          </div>

          <div class="path-card">
            <div class="path-icon">🌎</div>
            <h3>I'm just visiting</h3>
            <p>Discover the marketplace, merchandise and live events.</p>
            <a href="#live">Start discovering →</a>
          </div>

        </div>

        <div class="search-box">
          <input
            type="search"
            id="productSearch"
            placeholder="Search products, fashion, merchandise..."
            aria-label="Search sample products">

          <button class="btn btn-primary" id="searchButton">
            Search
          </button>
        </div>

        <div class="categories">
          <button class="category active" data-category="all">Everything</button>
          <button class="category" data-category="fashion">Fashion</button>
          <button class="category" data-category="electronics">Electronics</button>
          <button class="category" data-category="accessories">Accessories</button>
          <button class="category" data-category="merch">Fan merchandise</button>
        </div>

      </div>
    </section>

    <section class="section market-section" id="shop">
      <div class="container">

        <div class="section-header">
          <div>
            <h2>Explore the marketplace</h2>
            <p>A preview of the shopping experience we're building.</p>
          </div>
          <a href="#sell" class="text-link">Become a seller →</a>
        </div>

        <div class="product-grid" id="productGrid">

          <article class="product-card" data-category="fashion"
                   data-search="classic white t shirt fashion clothing">
            <div class="product-image">
              <img
                src="https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?auto=format&fit=crop&w=700&q=80"
                alt="Classic white T-shirt"
                loading="lazy">
              <span class="badge">Fashion</span>
            </div>
            <div class="product-info">
              <h3>Classic Essential Tee</h3>
              <p>Everyday style · Sample listing</p>
              <div class="product-bottom">
                <span class="price">Price not set</span>
                <a href="#sell" class="btn btn-outline">Details</a>
              </div>
              <span class="sample-label">ILLUSTRATIVE SAMPLE</span>
            </div>
          </article>

          <article class="product-card" data-category="electronics"
                   data-search="headphones audio electronics music">
            <div class="product-image">
              <img
                src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=700&q=80"
                alt="Wireless headphones"
                loading="lazy">
              <span class="badge">Electronics</span>
            </div>
            <div class="product-info">
              <h3>Wireless Audio</h3>
              <p>Audio essentials · Sample listing</p>
              <div class="product-bottom">
                <span class="price">Price not set</span>
                <a href="#sell" class="btn btn-outline">Details</a>
              </div>
              <span class="sample-label">ILLUSTRATIVE SAMPLE<
